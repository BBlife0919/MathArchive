# Streamlit Cloud 배포용 secrets 템플릿
#
# 실제 사용 방법:
# 1) Streamlit Cloud 대시보드 → 앱 → Settings → Secrets 패널에 아래 내용 붙여넣기
# 2) 로컬에서 클라우드 모드로 테스트하려면 이 파일을 secrets.toml 로 복사 후 값 채움
#
# secrets.toml 은 .gitignore 에 등록돼 있음 (자격증명 누출 방지).

SUPABASE_DB_URL = "postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Gmail SMTP (메일 발송 — 비번 재설정/아이디 안내)
# Google Account → 보안 → 앱 비밀번호 발급 (2단계 인증 활성화 필수, 16자리)
GMAIL_USER = "<your-gmail-address>"
GMAIL_APP_PASSWORD = "<16자리-앱-비번>"
SMTP_FROM_NAME = "MathArchive"

# 앱 베이스 URL (이메일 안 재설정 링크용)
APP_BASE_URL = "https://matharchive.streamlit.app"

# Cloudflare R2 (이미지 호스팅)
R2_ACCESS_KEY_ID = "<R2_ACCESS_KEY_ID>"
R2_SECRET_ACCESS_KEY = "<R2_SECRET_ACCESS_KEY>"
R2_ENDPOINT = "https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET = "<bucket-name>"
R2_PUBLIC_URL = "https://pub-<hash>.r2.dev"
