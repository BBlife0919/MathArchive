# 원본 HWPX 파일 (용량 큼 + 저작권 민감)
raw/

# 임시 압축해제 폴더
temp_extract/

# 파싱 결과 (재생성 가능)
parsed/

# 클라우드는 Supabase Postgres + R2 사용 → 로컬 sqlite는 git tracking 제외
# (GitHub 100MB 파일 한도 회피, 개인별 로컬 데이터 분리)
db/mathdb.sqlite
db/*.sqlite-journal

# SQLite WAL 임시 파일
*.sqlite-shm
*.sqlite-wal

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
.env
.env.*

# Streamlit secrets (실제 자격증명, Cloud secrets 패널에서 관리)
.streamlit/secrets.toml
