# 원본 HWPX 파일 (용량 큼 + 저작권 민감)
raw/

# 매쓰플랫 예시문항 이미지(few-shot 참고용 원본, 타사 저작물) — 용량 큼 +
# 저작권 민감. label_types.py 가 로컬에서만 읽는다. 코드/유형명은
# mf_examples_*.json 에 남아있어 필요하면 scripts/label_types_img_test.py
# 의 다운로드 로직으로 재생성 가능.
docs/mathflat_taxonomy/example_images/

# 추출 이미지: R2(Cloudflare)로 전량 이관 완료 (2026-08-07, images.image_path
# 24,666건 전부 R2 URL 확보). 로컬 images/ 는 이제 개발용 폴백일 뿐이라 git
# 추적 불필요 — 계속 추적하면 배치마다 GB 단위로 쌓여 푸시가 막힌다
# (2026-08-07 실제로 24GB까지 쌓여 git push 가 계속 실패해서 히스토리에서
# 제거한 사고 있었음). 파일 자체는 계속 로컬에 남고 파서도 그대로 씀 —
# git 추적만 안 할 뿐.
images/

# 임시 압축해제 폴더
temp_extract/

# 파싱 결과 (재생성 가능)
parsed/

# 클라우드는 Supabase Postgres + R2 사용 → 로컬 sqlite는 git tracking 제외
# (GitHub 100MB 파일 한도 회피, 개인별 로컬 데이터 분리)
db/mathdb.sqlite
db/*.sqlite-journal
db/*.bak_review
db/*.bak_review-shm
db/*.bak_review-wal

# SQLite WAL 임시 파일
*.sqlite-shm
*.sqlite-wal

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
.env
.env.*

# 세션 인계용 임시 메모 (커밋 X)
HANDOFF.md

# Streamlit secrets (실제 자격증명, Cloud secrets 패널에서 관리)
.streamlit/secrets.toml
